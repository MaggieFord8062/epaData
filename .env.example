# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://www.epa.gov/power-sector/cam-api-portal (needed only to pull data from the EPA)
CAMPD_API_KEY=paste-your-key-here

# Optional: any long random text, used to sign the session messages on the facility page
FLASK_SECRET_KEY=any-long-random-text
